# ============================================
# OfiAI Web - Variables de Entorno
# Copiar como .env.local y completar los valores
# ============================================

# API Backend
VITE_API_URL=http://localhost:8080/api/v1

# Firebase (obtener desde Firebase Console > Configuración del proyecto)
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Google Maps (para geolocalización)
VITE_GOOGLE_MAPS_API_KEY=AIza...

# Stripe (usar publishable key, NO la secret key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
