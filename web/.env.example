# ============================================
# OfiAI Web - Variables de Entorno
# Copiar como .env.local y completar los valores
# ============================================

# API Backend
VITE_API_URL=http://localhost:8080/api/v1

# Firebase (obtener desde Firebase Console > Configuración del proyecto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ofiai-2f357.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ofiai-2f357
VITE_FIREBASE_DATABASE_ID=default
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=597779936831
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google Maps (para geolocalización)
VITE_GOOGLE_MAPS_API_KEY=AIza...
VITE_DEFAULT_COUNTRY=AR

# Mercado Pago (public key, nunca access token)
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# Desarrollo
VITE_ENABLE_DEMO_ACCESS=false
