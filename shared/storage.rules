rules_version = '2';
// ============================================
// OfiAI - Reglas de Seguridad de Firebase Storage
// ============================================
service firebase.storage {
  match /b/{bucket}/o {

    // Avatares de usuario
    match /avatares/{usuarioId}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == usuarioId
                   && request.resource.size < 5 * 1024 * 1024 // Máximo 5MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Portafolio de profesionales
    match /portafolios/{profesionalId}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024 // Máximo 10MB
                   && (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType.matches('application/pdf'));
    }

    // Logos de empresas
    match /logos/{empresaId}/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
