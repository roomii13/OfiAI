rules_version = '2';
// ============================================
// OfiAI - Reglas de Seguridad de Firebase Storage
// ============================================
service firebase.storage {
  match /b/{bucket}/o {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return estaAutenticado() && request.auth.token.rol == 'admin';
    }

    // Avatares de usuario
    match /avatares/{usuarioId}/{archivo} {
      allow read: if estaAutenticado();
      allow create, update: if estaAutenticado()
        && request.auth.uid == usuarioId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if esAdmin() || (estaAutenticado() && request.auth.uid == usuarioId);
    }

    // Portafolio de profesionales
    match /portafolios/{profesionalId}/{archivo} {
      allow read: if estaAutenticado();
      allow create, update: if esAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('application/pdf')
        );
      allow delete: if esAdmin();
    }

    // Logos de empresas
    match /logos/{empresaId}/{archivo} {
      allow read: if estaAutenticado();
      allow create, update: if esAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if esAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
