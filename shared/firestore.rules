rules_version = '2';
// ============================================
// OfiAI - Reglas de Seguridad de Firestore
// ============================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== FUNCIONES AUXILIARES =====
    function estaAutenticado() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activo == true;
    }

    function esRol(rol) {
      return estaAutenticado()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == rol;
    }

    function esAdmin() {
      return esRol('admin');
    }

    function esEmpresa() {
      return esRol('empresa');
    }

    function esProfesional() {
      return esRol('profesional');
    }

    function esPropietario(usuarioId) {
      return estaAutenticado() && request.auth.uid == usuarioId;
    }

    // ===== USUARIOS =====
    match /users/{usuarioId} {
      allow read: if esPropietario(usuarioId) || esAdmin();
      // El registro ya se realiza mediante Auth API + Admin SDK, no escribiendo un rol desde el cliente.
      allow create: if esAdmin();
      allow update: if esAdmin()
        || (
          esPropietario(usuarioId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'nombre',
            'apellido',
            'telefono',
            'idioma',
            'ultimoAcceso',
            'fechaActualizacion'
          ])
        );
      allow delete: if esAdmin();
    }

    // ===== EMPRESAS =====
    match /companies/{empresaId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esAdmin();
    }

    // ===== PROFESIONALES =====
    match /professionals/{profesionalId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esAdmin();
    }

    // ===== TRABAJOS =====
    match /jobs/{trabajoId} {
      allow read: if esAdmin()
        || (esEmpresa() && get(/databases/$(database)/documents/companies/$(resource.data.empresaId)).data.usuarioId == request.auth.uid)
        || (esProfesional() && (resource.data.estado == 'publicado'
          || ('profesionalAsignadoId' in resource.data
            && get(/databases/$(database)/documents/professionals/$(resource.data.profesionalAsignadoId)).data.usuarioId == request.auth.uid)));
      allow create, update, delete: if esAdmin();
    }

    // Matching se consulta exclusivamente por la API con ownership; el SDK cliente no accede a leases ni resultados.
    match /jobs/{trabajoId}/matching/{runId} {
      allow read, write: if false;
    }
    match /jobs/{trabajoId}/matches/{professionalId} {
      allow read, write: if false;
    }

    // Intake siempre pasa por API autenticada; ningun cliente escribe contexto ni confirma directamente.
    // Pricing y presupuestos privados: exclusivamente API con ownership.
    match /jobs/{jobId}/pricing/{documentId} { allow read, write: if false; }
    match /jobs/{jobId}/pricing_quotes/{documentId} { allow read, write: if false; }
    match /jobs/{jobId}/pricing_estimates/{documentId} { allow read, write: if false; }
    match /jobs/{jobId}/pricing_audit/{documentId} { allow read, write: if false; }
    // Acuerdos y auditoria se consultan solo mediante API, con identidad de ambos participantes.
    match /jobs/{jobId}/coordinator/{documentId} { allow read, write: if false; }
    match /jobs/{jobId}/coordinator_history/{documentId} { allow read, write: if false; }
    match /jobs/{jobId}/coordinator_commands/{documentId} { allow read, write: if false; }
    match /jobs/{jobId}/coordinator_offers/{documentId} { allow read, write: if false; }
    match /coordination_workflows/{documentId} { allow read, write: if false; }
    match /coordinator_outbox/{documentId} { allow read, write: if false; }

    match /ai_intake_sessions/{sessionId} {
      allow read, write: if false;
    }

    // ===== PROPUESTAS =====
    match /proposals/{propuestaId} {
      allow read: if esAdmin()
        || (esEmpresa() && get(/databases/$(database)/documents/companies/$(resource.data.empresaId)).data.usuarioId == request.auth.uid)
        || (esProfesional() && get(/databases/$(database)/documents/professionals/$(resource.data.profesionalId)).data.usuarioId == request.auth.uid);
      allow create, update, delete: if esAdmin();
    }

    // ===== RESEÑAS =====
    match /reviews/{resenaId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if esAdmin();
    }

    // ===== SUSCRIPCIONES =====
    // CRM privado: consentimiento, etapas y mensajes solo se procesan por API.
    match /sales_leads/{document=**} { allow read, write: if false; }
    match /marketing_campaigns/{document=**} { allow read, write: if false; }
    match /support_sessions/{document=**} { allow read, write: if false; }
    match /support_tickets/{document=**} { allow read, write: if false; }
    match /agent_runs/{document=**} { allow read, write: if false; }
    match /agent_events/{document=**} { allow read, write: if false; }
    match /ai_knowledge/{document=**} { allow read, write: if false; }
    match /agent_audit/{document=**} { allow read, write: if false; }
    match /ai_budgets/{document=**} { allow read, write: if false; }
    match /ai_observations/{document=**} { allow read, write: if false; }
    // Facturacion y cuotas solo se modifican desde el backend autenticado.
    match /billing_accounts/{uid}/{document=**} { allow read, write: if false; }
    match /billing_payments/{id} { allow read, write: if false; }
    match /billing_revenue/{id} { allow read, write: if false; }
    match /billing_tasks/{id} { allow read, write: if false; }
    match /subscriptions/{suscripcionId} {
      allow read: if esPropietario(resource.data.usuarioId) || esAdmin();
      allow create, update, delete: if false;
    }

    // ===== HISTORIAL DE SUSCRIPCIONES =====
    match /subscription_history/{historialId} {
      allow read: if esPropietario(resource.data.usuarioId) || esAdmin();
      allow create, update, delete: if false;
    }

    // ===== NOTIFICACIONES =====
    match /notifications/{notificacionId} {
      allow read: if esPropietario(resource.data.usuarioId) || esAdmin();
      allow create: if esAdmin();
      allow update: if esAdmin()
        || (
          esPropietario(resource.data.usuarioId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'leida',
            'fechaLeida'
          ])
        );
      allow delete: if esAdmin();
    }

    // ===== ANALYTICS =====
    match /analytics_events/{eventoId} {
      allow read, write: if esAdmin();
    }

    match /analytics_reports/{reporteId} {
      allow read, write: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
