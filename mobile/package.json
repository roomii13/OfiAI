{
  "name": "ofiai-mobile",
  "version": "1.0.0",
  "description": "OfiAI - Aplicación Móvil (Android & iOS) con IA para gestión de profesionales",
  "main": "expo/AppEntry.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "test:dependencies": "node --test dependency-compatibility.test.cjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "@grpc/grpc-js": "^1.14.5",
    "image-size": "^2.0.4",
    "postcss": "^8.5.28",
    "undici": "^6.29.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.1.3"
  }
}
