# OfiAI Backend - variables de entorno
# Copiar como .env y completar con credenciales reales.

NODE_ENV=production
PORT=8080
API_VERSION=v1

# Firebase Admin
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=ofiai-2f357
# ID real de la base; default y (default) son bases distintas.
FIREBASE_DATABASE_ID=default
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ofiai-2f357.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
# Agente Intake: modelo independiente del chat heredado; solo backend.
GEMINI_INTAKE_MODEL=gemini-3.6-flash
GEMINI_INTAKE_TIMEOUT_MS=30000
# Matching independiente del Intake; conserva fallback si Gemini falla.
GEMINI_MATCHING_MODEL=gemini-3.6-flash
GEMINI_MATCHING_ENABLED=true
MATCHING_CACHE_TTL_SECONDS=1800
GEMINI_PRICING_MODEL=gemini-3.6-flash
GEMINI_PRICING_ENABLED=true

# Google Maps
GOOGLE_MAPS_API_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=ARS
MERCADOPAGO_NOTIFICATION_URL=https://api.tu-dominio.com/api/v1/subscriptions/webhooks/mercadopago

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@tu-dominio.com

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Scheduler
SCHEDULER_ENABLED=true

# Google Cloud
GCP_PROJECT_ID=ofiai-2f357
GCP_REGION=us-central1

# Seguridad
JWT_SECRET=
CORS_ORIGINS=https://app.tu-dominio.com
