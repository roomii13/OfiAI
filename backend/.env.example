# OfiAI Backend - variables de entorno
# Copiar como .env y completar con credenciales reales.

NODE_ENV=production
PORT=8080
API_VERSION=v1

# Firebase Admin
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=ofiai-2f357
# ID real de la base; default y (default) son bases distintas.
FIREBASE_DATABASE_ID=default
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ofiai-2f357.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Groq: usar credencial de una organizacion Free para evitar facturacion por uso.
# No habilitar Developer/Paid pensando que esta configuracion impide cargos en Groq.
GROQ_API_KEY=
# Modelo Preview, configurable; validar disponibilidad antes del despliegue.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_MAX_INPUT_CHARACTERS=60000
# Si Groq falla se usan reglas o un error amigable, nunca proveedores pagos por defecto.
AI_LEGACY_FALLBACK_ENABLED=false

# Proveedores anteriores conservados; no se invocan con el fallback deshabilitado.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000
GEMINI_MODEL=gemini-3.6-flash
# Agente Intake: modelo independiente del chat heredado; solo backend.
GEMINI_INTAKE_MODEL=gemini-3.6-flash
GEMINI_INTAKE_TIMEOUT_MS=30000
# Matching independiente del Intake; conserva fallback si Gemini falla.
GEMINI_MATCHING_MODEL=gemini-3.6-flash
GEMINI_MATCHING_ENABLED=true
MATCHING_CACHE_TTL_SECONDS=1800
GEMINI_PRICING_MODEL=gemini-3.6-flash
GEMINI_PRICING_ENABLED=true

# Google Maps
GOOGLE_MAPS_API_KEY=

# Mercado Pago
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=ARS
# Precios comerciales USD: PRO 3, BUSINESS 20, PRO+ 59, BUSINESS PRO 79, ENTERPRISE 149.
# Vacio: cotizacion automatica de Mercado Pago. Un valor fija la conversion manualmente.
BILLING_USD_TO_ARS=
# Overrides JSON por ID de plan: {priceUsd,limits:{trabajosPublicados,propuestasEnviadas,consultasIA,perfilesVisibles}}
BILLING_CATALOG_JSON={}
# Catalogo futuro nativo [{provider:"google_play"|"apple",plan,productId,audience}]. No habilita compras.
BILLING_STORE_PRODUCTS_JSON=[]
# 100 basis points = 1%. Vacio: sin politica de comision; no se ejecutan cobros por contratacion.
BILLING_TRANSACTION_FEE_BPS=
MERCADOPAGO_NOTIFICATION_URL=https://api.tu-dominio.com/api/v1/subscriptions/webhooks/mercadopago

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=notificaciones@tu-dominio.com

# WhatsApp Business Cloud API: opcional, completar ambas o dejar ambas vacias.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Cache
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Scheduler
SCHEDULER_ENABLED=true

# Google Cloud
GCP_PROJECT_ID=ofiai-2f357
GCP_REGION=us-central1

# Seguridad
# 0 para acceso directo. En ofiai-api se verificaron 3 saltos; revisar por alojamiento.
TRUST_PROXY_HOPS=0
# Agentes comerciales: Groq requiere clave; sin clave se mantienen las reglas.
AI_BUSINESS_LLM_ENABLED=true
AI_BUSINESS_DAILY_CALL_LIMIT=20
# Tarifas USD por millon de tokens, verificadas por el operador para los modelos configurados.
# Claves admitidas: groq, deepseek, gemini. Sin tarifas, costo desconocido, no cero.
AI_COST_RATES_JSON={}
JWT_SECRET=
CORS_ORIGINS=https://app.tu-dominio.com
