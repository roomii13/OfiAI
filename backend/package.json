{
  "name": "ofiai-backend",
  "version": "1.0.0",
  "description": "OfiAI - Backend API REST con IA para la gestión de profesionales de oficios en LATAM",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "^11.1.1"
    },
    "@fastify/busboy": "^3.2.2"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "resend": "^3.2.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.3",
    "wrangler": "4.147.0"
  }
