# ============================================
# OfiAI - .gitignore
# ============================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Builds
dist/
build/
.expo/
android/
ios/

# Variables de entorno (NUNCA subir al repositorio)
.env
.env.local
.env.*.local
.env.production
.dev.vars
.dev.vars.*
.wrangler/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editores
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sistema operativo
.DS_Store
Thumbs.db

# Firebase
.firebase/
firebase-debug.log
.firebaserc

# Google Cloud
gcloud-service-account.json
*.pem
*.key

# TypeScript
*.js.map
*.d.ts.map

# Testing
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
